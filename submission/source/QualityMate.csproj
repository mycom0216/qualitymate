<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefaultItemExcludes>$(DefaultItemExcludes);submission/**;tmp/**;data/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Content Remove="data/**/*;tools/**/*;tmp/**/*;submission/**/*" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <Content Update="knowledge/**/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

